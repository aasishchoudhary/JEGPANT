# Copy to .env and fill the required values. Never commit a populated .env file.
JEGPANT_DOMAIN=private.example.com
JEGPANT_TLS_EMAIL=owner@example.com

# Fixed UUID for this one cognitive instance.
JEGPANT_INSTANCE_ID=00000000-0000-4000-8000-000000000001

# Base64 DER X.509 SubjectPublicKeyInfo from the Android Keystore owner P-256 key.
# This is public material, not the private signing key.
JEGPANT_OWNER_PUBLIC_KEY_B64=REPLACE_WITH_BASE64_DER_OWNER_PUBLIC_KEY

# First startup only: initializes a local data-key file inside the Docker volume.
# Keep true if the volume is lost? NO. After the first successful startup, change to false.
JEGPANT_INITIALIZE_LOCAL_STORAGE=true

# Media and API request limits.
JEGPANT_MAX_MEDIA_BYTES=8589934592
JEGPANT_MAX_JSON_BYTES=1048576

# Optional private HTTPS inference endpoint. The worker profile is disabled by default.
# For a local worker-side endpoint, the default is http://127.0.0.1:3001/v1.
JEGPANT_LLM_BASE_URL=http://127.0.0.1:3001/v1
JEGPANT_LLM_MODEL=local-model
JEGPANT_LLM_API_KEY=
JEGPANT_LLM_TIMEOUT_SECONDS=120
JEGPANT_ALLOW_REMOTE_INFERENCE=false
